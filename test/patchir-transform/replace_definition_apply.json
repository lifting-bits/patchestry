// replace_definition swaps the body of an existing function for the patch
// function's body.  Emptying the old body used to abort the tool with
// "operation destroyed but still has uses": the blocks were cleared while
// their operations still referred to each other.
//
// The target returns `_Bool`, so this also checks that a lifted bool function
// and a patch compiled from C agree on the signature.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -output %t1 >> /dev/null 2>&1
// RUN: %patchir-transform %t1.cir --spec %S/replace_definition_apply.yaml -o %t2.cir
// RUN: sed -n '/cir.func.*@is_set(/,/^  }/p' %t2.cir > %t2.fn.cir
// RUN: %file-check -vv -check-prefix=CIR %s --input-file %t2.fn.cir
// RUN: %patchir-cir2llvm -S %t2.cir -o %t2.ll >> /dev/null 2>&1
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t2.ll
//
// The signature is kept and the body is the patch's: `!flag`.
// CIR: cir.func dso_local @is_set(%arg0: !cir.bool) -> !cir.bool attributes {patchestry_definition_replaced_by = "patch__replace__is_set"}
// CIR: cir.unary(not,
// CIR: cir.return
//
// LL: define dso_local i32 @is_set(i1 zeroext %0)
{
  "architecture": "ARM",
  "id": "ARM:LE:32:v7",
  "format": "Executable and Linking Format (ELF)",
  "functions": {
    "ram:00010000": {
