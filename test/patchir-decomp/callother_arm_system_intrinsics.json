// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -emit-llvm -output %t >> /dev/null 2>&1
// RUN: %file-check -vv -check-prefix=CIR %s --input-file %t.cir
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
//
// ARM system userops the Ghidra UseropClassifier tagged with an intrinsic_class
// map to CMSIS-Core / ACLE spellings. Verifies CPS masking, a sysreg write, a
// sysreg read (return), an ACLE coprocessor LDC, and the WFI hint.
//
// CIR: cir.func dso_local @arm_sys_test
// LL: define dso_local i32 @arm_sys_test
// LL-DAG: call {{.*}}@__disable_irq()
// LL-DAG: call {{.*}}@__set_BASEPRI(
// LL-DAG: call {{.*}}@__get_IPSR()
// LDC address (input 2) is cast to a pointer so __arm_ldc recompiles against
// <arm_acle.h> (whose 3rd parameter is const void *) instead of failing
// int->pointer conversion.
// LL-DAG: call {{.*}}@__arm_ldc(i32 {{.*}}, i32 {{.*}}, ptr
// LL-DAG: call {{.*}}@__wfi()
// LL-DAG: call {{.*}}@__enable_irq()
// Coprocessor MCR/MRC reorder: Ghidra moveto(cpn,op1,op2,Rt,CRn,CRm) ->
// ACLE __arm_mcr(cpn,op1,Rt,CRn,CRm,op2). opc1=2,opc2=4 distinct so the swap
// is visible: opc2(4) lands last, value sits at position 3.
// LL-DAG: call {{.*}}@__arm_mcr(i32 15, i32 2, i32 {{.*}}, i32 1, i32 3, i32 4)
// LL-DAG: call i32 {{.*}}@__arm_mrc(i32 15, i32 2, i32 1, i32 3, i32 4)
{
  "architecture": "ARM",
  "id": "ARM:LE:32:Cortex",
  "format": "Executable and Linking Format (ELF)",
  "functions": {
    "ram:10000000": {
      "name": "arm_sys_test",
      "is_intrinsic": false,
      "type": {
        "return_type": "type_int",
        "is_variadic": false,
        "is_noreturn": false,
        "parameter_types": ["type_int"]
      },
      "basic_blocks": {
        "ram:10000000:entry": {
          "operations": {
            "p0": { "mnemonic": "DECLARE_PARAMETER", "name": "v", "type": "type_int", "kind": "parameter", "index": 0 },
            "temp0": { "mnemonic": "DECLARE_TEMPORARY", "name": "exc", "kind": "temporary", "type": "type_int", "address": "ram:10000000:0:basic:read_ipsr" },
            "temp1": { "mnemonic": "DECLARE_TEMPORARY", "name": "cpval", "kind": "temporary", "type": "type_int", "address": "ram:10000000:0:basic:mrc" },
            "br": { "mnemonic": "BRANCH", "target_block": "ram:10000000:0:basic" }
          },
          "ordered_operations": ["p0", "temp0", "temp1", "br"]
        },
        "ram:10000000:0:basic": {
          "operations": {
            "cpsid": {
              "mnemonic": "CALLOTHER",
              "target": {
                "kind": "intrinsic", "function": "disableIRQinterrupts",
                "is_variadic": false, "is_noreturn": false,
                "intrinsic_class": "irq_mask_set", "system_register": "PRIMASK"              },
              "inputs": []
            },
            "set_basepri": {
              "mnemonic": "CALLOTHER",
              "target": {
                "kind": "intrinsic", "function": "setBasePriority",
                "is_variadic": false, "is_noreturn": false,
                "intrinsic_class": "sysreg_write", "system_register": "BASEPRI"              },
              "inputs": [{ "type": "type_int", "kind": "parameter", "operation": "p0" }]
            },
            "read_ipsr": {
              "mnemonic": "CALLOTHER",
              "type": "type_int",
              "output": { "kind": "temporary", "operation": "temp0", "type": "type_int" },
              "target": {
                "kind": "intrinsic", "function": "getCurrentExceptionNumber",
                "is_variadic": false, "is_noreturn": false,
                "intrinsic_class": "sysreg_read", "system_register": "IPSR"              },
              "inputs": []
            },
            "ldc": {
              "mnemonic": "CALLOTHER",
              "target": {
                "kind": "intrinsic", "function": "coprocessor_load",
                "is_variadic": false, "is_noreturn": false,
                "intrinsic_class": "coproc_load"              },
              "inputs": [
                { "type": "type_int", "size": 4, "kind": "constant", "value": 11 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 0 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 0 }
              ]
            },
            "mcr": {
              "mnemonic": "CALLOTHER",
              "target": {
                "kind": "intrinsic", "function": "coprocessor_moveto",
                "is_variadic": false, "is_noreturn": false,
                "intrinsic_class": "coproc_write"              },
              "inputs": [
                { "type": "type_int", "size": 4, "kind": "constant", "value": 15 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 2 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 4 },
                { "type": "type_int", "kind": "parameter", "operation": "p0" },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 1 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 3 }
              ]
            },
            "mrc": {
              "mnemonic": "CALLOTHER",
              "type": "type_int",
              "output": { "kind": "temporary", "operation": "temp1", "type": "type_int" },
              "target": {
                "kind": "intrinsic", "function": "coprocessor_movefromRt",
                "is_variadic": false, "is_noreturn": false,
                "intrinsic_class": "coproc_read"              },
              "inputs": [
                { "type": "type_int", "size": 4, "kind": "constant", "value": 15 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 2 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 4 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 1 },
                { "type": "type_int", "size": 4, "kind": "constant", "value": 3 }
              ]
            },
            "wfi": {
              "mnemonic": "CALLOTHER",
              "target": {
                "kind": "intrinsic", "function": "WaitForInterrupt",
                "is_variadic": false, "is_noreturn": false,
                "intrinsic_class": "hint_wfi"              },
              "inputs": []
            },
            "cpsie": {
              "mnemonic": "CALLOTHER",
              "target": {
                "kind": "intrinsic", "function": "enableIRQinterrupts",
                "is_variadic": false, "is_noreturn": false,
                "intrinsic_class": "irq_mask_clear", "system_register": "PRIMASK"              },
              "inputs": []
            },
            "ret": {
              "mnemonic": "RETURN",
              "inputs": [{ "type": "type_int", "kind": "temporary", "operation": "read_ipsr" }]
            }
          },
          "ordered_operations": ["cpsid", "set_basepri", "read_ipsr", "ldc", "mcr", "mrc", "wfi", "cpsie", "ret"]
        }
      },
      "entry_block": "ram:10000000:entry"
    }
  },
  "globals": {},
  "types": {
    "type_int": { "name": "unsigned int", "size": 4, "kind": "integer" }
  }
}
