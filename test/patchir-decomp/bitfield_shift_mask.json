//
// Ghidra 12.2 export of test/ghidra/bitfield.c, built for AArch64 at -O1, as
// the export scripts produce it: the decompiler option "Simplify bitfield
// access" is off, so bit-field accesses are the shifts and masks of the binary
// and there is no ZPULL, SPULL or INSERT.  Ghidra 12.0.4 reports the same
// operations for this object.
// JSON-NOT: "ZPULL"
// JSON-NOT: "SPULL"
// JSON-NOT: "INSERT"
//
// LOG-NOT: unsupported mnemonic
// LOG-NOT: op-dropped
// LOG-NOT: return-synthesized
//
// reg_update reads a volatile register once, updates two fields in a copy
// and writes the register once.  The lift has one load from the register and
// one store to it: the only load and the only store through a loaded pointer.
// With the option on, Ghidra reports two read-modify-write sequences here.
// REG-LABEL: define dso_local void @reg_update(
// REG: [[R:%[0-9]+]] = load ptr, ptr
// REG-NEXT: load i32, ptr [[R]], align 4
// REG-NOT: load ptr
// REG: [[W:%[0-9]+]] = load ptr, ptr
// REG-NEXT: store i32 %{{[0-9]+}}, ptr [[W]], align 4
// REG-NOT: load ptr
// REG: ret void
//
// The bit-field unit is four bytes of a 48-byte struct.
// BIG-LABEL: define dso_local void @big_set(
// BIG: shl i32 %{{[0-9]+}}, 8
// BIG: [[P:%[0-9]+]] = load ptr, ptr
// BIG-NEXT: store i32 %{{[0-9]+}}, ptr [[P]], align 4
//
// The bit-field unit is four bytes at byte 1 of a packed struct.
// PACKED-LABEL: define dso_local void @packed_set(
// PACKED: [[A:%[0-9]+]] = getelementptr i8, ptr %{{[0-9]+}}, i64 1
// PACKED-NEXT: load i32, ptr [[A]]
// PACKED: shl i32 %{{[0-9]+}}, 6
// PACKED: [[B:%[0-9]+]] = getelementptr i8, ptr %{{[0-9]+}}, i64 1
// PACKED-NEXT: store i32 %{{[0-9]+}}, ptr [[B]]
//
// Two fields written by one load and one store, as in the binary.
// SET-LABEL: define dso_local void @bitfield_set(
// SET: [[S:%[0-9]+]] = load ptr, ptr
// SET-NEXT: load i32, ptr [[S]], align 4
// SET-NOT: load ptr
// SET: [[D:%[0-9]+]] = load ptr, ptr
// SET-NEXT: store i32 %{{[0-9]+}}, ptr [[D]], align 4
// SET-NOT: load ptr
// SET: ret void
