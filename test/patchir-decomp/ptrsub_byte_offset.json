// The second input of PTRSUB is a byte offset.  For a base that does not point
// to a structure the lifter used to cast the base to the output type and add
// the offset with C pointer arithmetic, which scales by the pointee size:
// PTRSUB(p, 4) with an `unsigned int *` output moved 16 bytes, not 4.  The
// arithmetic is now done in `char *` and the result converted to the output
// type.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
//
// C-DAG: return (unsigned int *)((char *)p + 4U);
// C-DAG: return (unsigned int *)((char *)p + 6U);
// C-DAG: return (unsigned int **)((char *)p + 4U);
// C-DAG: return (signed char *)((char *)p + 4U);
// C-DAG: return (void *)((char *)p + 4U);
// C-NOT: return p + 4U;
//
// LL-NOT: getelementptr i32
// LL-NOT: getelementptr ptr
// LL: define {{.*}}@ptrsub_
// LL: getelementptr i8, ptr %{{[0-9]+}}, i32 {{4|6}}
