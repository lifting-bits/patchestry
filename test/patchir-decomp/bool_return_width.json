// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -emit-llvm -print-tu -output %t >> /dev/null 2>&1
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
// RUN: %file-check -vv -check-prefix=CIR %s --input-file %t.cir
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
// RUN: %patchir-cir2llvm -S %t.cir -o %t.from-cir.ll >> /dev/null 2>&1
// RUN: %file-check -vv -check-prefix=CIR2LL %s --input-file %t.from-cir.ll
//
// On 32-bit ARM a function Ghidra types as returning `bool` returns in the
// whole of r0, and the code compiled against it tests the whole register
// (`cmp r0, #0`).  As an `i1` the call result is read as one bit: the backend
// masks it (`and r0, r0, #1`) before using it, so a callee that returns 2
// reads as false.  Ghidra assigns `bool` from how a result is used, so such
// callees exist.
//
// The C and ClangIR signatures stay `_Bool`: patches are matched against
// them, and the rule below belongs to one ABI.
// C-DAG: _Bool callee(void);
// C-DAG: _Bool is_set(_Bool flag) {
// C-DAG: return flag;
// C-DAG: ok = callee();
// CIR-DAG: @is_set(%arg0: !cir.bool{{.*}}) -> !cir.bool
//
// In the LLVM module, on both paths to it, an `i1` result becomes `i32`.  The
// call compares the whole result with zero and a definition zero-extends the
// `_Bool` it returns.  A `_Bool` parameter stays `i1` and gets the `zeroext`
// ClangIR leaves out.
// LL-DAG: declare i32 @callee()
// LL-DAG: define dso_local i32 @is_set(i1 zeroext %0)
// LL-DAG: [[R:%.*]] = call i32 @callee()
// LL-DAG: icmp ne i32 [[R]], 0
// LL-NOT: call i1
//
// CIR2LL-DAG: define dso_local i32 @is_set(i1 zeroext %0)
// CIR2LL-DAG: call i32 @callee()
//
// Other targets are left alone.  On x86-64 a `_Bool` result occupies al and
// the rest of rax is unspecified, so a whole-register test would be wrong.
// RUN: sed -e 's/"architecture": "ARM"/"architecture": "x86"/' -e 's/"ARM:LE:32:v7"/"x86:LE:64:default"/' %t.json > %t.x64.json
// RUN: %patchir-decomp -input %t.x64.json -emit-llvm -output %t.x64 >> /dev/null 2>&1
// RUN: %file-check -vv -check-prefix=X64 %s --input-file %t.x64.ll
// X64-DAG: declare i1 @callee()
// X64-DAG: call i1 @callee()
// X64-DAG: define dso_local i1 @is_set(i1 %0)
// X64-NOT: zeroext
{
  "architecture": "ARM",
  "id": "ARM:LE:32:v7",
  "format": "Executable and Linking Format (ELF)",
  "functions": {
    "ram:00010000": {
      "name": "caller",
      "is_intrinsic": false,
      "type": {
        "return_type": "t_int",
        "is_variadic": false,
        "is_noreturn": false,
        "parameter_types": []
      },
      "basic_blocks": {
        "ram:00010000:entry": {
          "operations": {
            "ok": {
              "mnemonic": "DECLARE_LOCAL",
              "name": "ok",
              "kind": "local",
              "type": "t_bool"
            },
            "entry.exit": {
              "mnemonic": "BRANCH",
              "target_block": "ram:00010000:0:basic"
            }
          },
          "ordered_operations": [
            "ok",
            "entry.exit"
          ]
        },
        "ram:00010000:0:basic": {
          "operations": {
            "call": {
              "mnemonic": "CALL",
              "type": "t_bool",
              "size": 1,
              "output": {
                "kind": "local",
                "operation": "ok"
              },
              "has_return_value": true,
              "target": {
                "kind": "function",
                "function": "ram:00020000",
                "is_variadic": false,
                "is_noreturn": false
              },
              "inputs": []
            },
            "wide": {
              "mnemonic": "INT_ZEXT",
              "type": "t_int",
              "size": 4,
              "inputs": [
                {
                  "type": "t_bool",
                  "size": 1,
                  "kind": "local",
                  "operation": "ok"
                }
              ]
            },
            "ret": {
              "mnemonic": "RETURN",
              "inputs": [
                {
                  "type": "t_int",
                  "size": 4,
                  "kind": "temporary",
                  "operation": "wide"
                }
              ]
            }
          },
          "ordered_operations": [
            "call",
            "wide",
            "ret"
          ]
        }
      },
      "entry_block": "ram:00010000:entry"
    },
    "ram:00020000": {
      "name": "callee",
      "is_intrinsic": false,
      "type": {
        "return_type": "t_bool",
        "is_variadic": false,
        "is_noreturn": false,
        "parameter_types": []
      }
    },
    "ram:00030000": {
      "name": "is_set",
      "is_intrinsic": false,
      "type": {
        "return_type": "t_bool",
        "is_variadic": false,
        "is_noreturn": false,
        "parameter_types": [
          "t_bool"
        ]
      },
      "basic_blocks": {
        "ram:00030000:entry": {
          "operations": {
            "p0": {
              "mnemonic": "DECLARE_PARAMETER",
              "name": "flag",
              "type": "t_bool",
              "kind": "parameter",
              "index": 0
            },
            "entry.exit": {
              "mnemonic": "BRANCH",
              "target_block": "ram:00030000:0:basic"
            }
          },
          "ordered_operations": [
            "p0",
            "entry.exit"
          ]
        },
        "ram:00030000:0:basic": {
          "operations": {
            "ret": {
              "mnemonic": "RETURN",
              "inputs": [
                {
                  "type": "t_bool",
                  "size": 1,
                  "kind": "parameter",
                  "operation": "p0"
                }
              ]
            }
          },
          "ordered_operations": [
            "ret"
          ]
        }
      },
      "entry_block": "ram:00030000:entry"
    }
  },
  "globals": {},
  "types": {
    "t_int": {
      "is_signed": true,
      "name": "int",
      "size": 4,
      "kind": "integer"
    },
    "t_bool": {
      "is_signed": false,
      "name": "bool",
      "size": 1,
      "kind": "boolean"
    }
  }
}
