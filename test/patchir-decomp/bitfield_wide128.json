// RUN: %cc-aarch64 -fsyntax-only -Werror -x c %t.c
//
// ZPULL, SPULL and INSERT on a 16-byte operand print as C the compiler accepts.
//
//   struct wide128 { unsigned __int128 lo : 70, mid : 5; __int128 hi : 53; };
//   void     wide128_set_mid(struct wide128 *p, unsigned v) { p->mid = v; }
//   unsigned wide128_get_mid(const struct wide128 *p)       { return p->mid; }
//   long     wide128_get_hi(const struct wide128 *p)        { return p->hi; }
//
// Ghidra 12.2 splits this 16-byte unit into 8-byte accesses, so the export
// (AArch64, -O1, "Simplify bitfield access" on) was edited by hand to operate
// on the whole unit: each LOAD and STORE is 16 bytes of type uint16 at offset
// 0, and the bit positions are those of the fields in the unit (70 and 75).
// The typedefs the export names "unsigned __int128" and "__int128" are renamed
// u128_t and i128_t, because C cannot redeclare those names.
//
// A literal of a 128-bit type prints as a bare decimal number.  The keep mask
// of the INSERT was a 39-digit literal the compiler rejects, and `31` and the
// field printed without their conversion to 128 bits, so the shift by 70 was
// a shift of an unsigned int.  The constants are now built from 64-bit
// literals and every widening is an explicit cast.  -Werror: no diagnostic of
// any kind is expected.
//
// LL-LABEL: define dso_local i64 @wide128_get_hi(
// LL: load i128
// LL: lshr i128 %{{[0-9]+}}, 75
//
// LL-LABEL: define dso_local i32 @wide128_get_mid(
// LL: load i128
// LL: lshr i128 %{{[0-9]+}}, 70
// LL-NEXT: and i128 %{{[0-9]+}}, 31
//
// LL-LABEL: define dso_local void @wide128_set_mid(
// LL: and i128 %{{[0-9]+}}, -36598340242239750406145
// LL: [[V:%[0-9]+]] = zext i32 %{{[0-9]+}} to i128
// LL-NEXT: [[M:%[0-9]+]] = and i128 [[V]], 31
// LL-NEXT: shl i128 [[M]], 70
// LL: store i128
//
// TU-DAG: >> 70U) & (unsigned __int128)31UL);
// TU-DAG: >> 75U) & (unsigned __int128)9007199254740991UL) ^ (unsigned __int128)4503599627370496UL) - (unsigned __int128)4503599627370496UL);
// TU-DAG: & (((unsigned __int128)18446744073709549631UL << 64U) | (unsigned __int128)18446744073709551615UL)) | (((unsigned __int128)v & (unsigned __int128)31UL) << 70U));
