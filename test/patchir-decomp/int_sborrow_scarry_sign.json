// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -output %t >> /dev/null 2>&1
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
//
// INT_SBORROW and INT_SCARRY leave their flag in the top bit of a bitwise
// expression, and the lifter reads it with `< 0`.  That comparison used to be
// done in the type of the operands:
//
//   - unsigned operands (Ghidra types most registers `unsigned int`) made it
//     `icmp ult x, 0`, which is always false, so the flag was never set;
//   - operands narrower than int were promoted, so the bit tested was bit 31
//     of the promoted value, not the top bit of the operand.
//
// The expression is now cast to the signed type of the operand's width
// before the comparison.
//
// LL-LABEL: define dso_local i32 @sborrow_s8
// LL: [[B:%.*]] = trunc i32 {{%.*}} to i8
// LL: [[W:%.*]] = sext i8 [[B]] to i32
// LL: icmp slt i32 [[W]], 0
// LL-LABEL: define dso_local i32 @sborrow_u32
// LL-NOT: icmp ult
// LL: icmp slt i32 {{%.*}}, 0
// LL-LABEL: define dso_local i32 @scarry_u32
// LL-NOT: icmp ult
// LL: icmp slt i32 {{%.*}}, 0
{
  "architecture": "ARM",
  "id": "ARM:LE:32:v7",
  "format": "Executable and Linking Format (ELF)",
  "functions": {
    "ram:00010000": {
      "name": "sborrow_u32",
      "is_intrinsic": false,
      "type": {
        "return_type": "t_int",
        "is_variadic": false,
        "is_noreturn": false,
        "parameter_types": [
          "t_uint",
          "t_uint"
        ]
      },
      "basic_blocks": {
        "ram:00010000:entry": {
