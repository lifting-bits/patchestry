//   DataMemoryBarrier, DataSynchronizationBarrier,
//   InstructionSynchronizationBarrier, ClearExclusiveLocal
// Source: Ghidra/Processors/ARM/data/languages/*.sinc
//
// AArch32 has no compiler-rt outline-atomic helpers (those exist only for
// AArch64), so this fixture covers only the SLEIGH userop vocabulary.

