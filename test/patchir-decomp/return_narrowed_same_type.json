// The returned varnode's P-Code size is compared with the declared return
// type even when its serialized type already is the return type.  The value
// is then truncated while the expression is built, with no cast to notice.
//
//   wide_const       8-byte constant 0x100000000 typed `unsigned int`: lifted
//                    as `return 0U;`, reported
//   wide_const_fits  8-byte constant 7 typed `unsigned int`: the value
//                    survives, not reported
//   wide_param       an 8-byte varnode typed `unsigned int`: reported
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=WARN %s --input-file %t.log
// RUN: grep -c "return-narrowed" %t.log | %file-check -check-prefix=COUNT %s
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
// RUN: not %patchir-decomp -input %t.json -emit-cir -strict -output %t.strict > %t.strict.log 2>&1
// RUN: test ! -e %t.strict.cir
