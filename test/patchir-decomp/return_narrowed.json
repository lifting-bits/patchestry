// A 64-bit value returned from a 32-bit ARM function travels in r0:r1.  When
// the prototype names a 64-bit return type the whole value survives.  When the
// prototype only names the low register, the lifter truncates the returned
// value to the declared type and the high word is gone; that is now reported.
// A RETURN with no value in a function that returns one is reported too.
//
//   ret_wide_declared   u64 f(u64 v) { return v; }   ret i64, no report
//   ret_wide_narrowed   u32 f(u64 v) { return v; }   high word dropped
//   ret_missing         u32 f(u32 a) { return; }     zero returned
//   ret_after_noreturn  u32 f(u32 a) { abort(); return; }   no report: the
//                       return follows a noreturn call and never executes
//   ret_promoted        u8 f(u32 a, u32 b) { return a == b; }   no report: the
//                       P-Code value is 1 byte; only the C expression is an int
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=WARN %s --input-file %t.log
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
// RUN: not %patchir-decomp -input %t.json -emit-llvm -strict -output %t.strict > %t.strict.log 2>&1
// RUN: %file-check -vv -check-prefix=ERR %s --input-file %t.strict.log
// RUN: test ! -e %t.strict.ll
