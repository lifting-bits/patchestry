// Lifted code states what the binary does to memory; the recovered types and
// object boundaries are estimates.  The lifter therefore compiles it with
// type-based aliasing off, pointer overflow defined and signed arithmetic
// wrapping, so nothing downstream can optimize on a promise the binary never
// made.  The LLVM IR for a member access, an array index, raw byte arithmetic
// and signed additions must carry none of: `inbounds`, `nsw`/`nuw`, `!tbaa`,
// `noalias`, lifetime markers.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
//
// C: *(int *)((char *)arr + 8) = n;
// C: return rec->second + arr[n] + (*(int *)((char *)arr + 8));
//
// LL-NOT: inbounds
// LL-NOT: nsw
// LL-NOT: nuw
// LL-NOT: !tbaa
// LL-NOT: noalias
// LL-NOT: llvm.lifetime
// LL: define {{.*}}@memory_model
// LL: getelementptr i8, ptr %{{[0-9]+}}, i32 8
// LL: getelementptr %struct.rec, ptr %{{[0-9]+}}, i32 0, i32 1
// LL: getelementptr i32, ptr %{{[0-9]+}}, i32 %{{[0-9]+}}
// LL: add i32
// LL: add i32
