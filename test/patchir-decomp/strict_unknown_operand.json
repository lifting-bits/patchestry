// An operand the JSON parser cannot read keeps its slot as an unknown
// placeholder.  Not every operation builds every operand, so the placeholder
// is refused before the operation is built:
//
//   return_unknown           RETURN of an unknown operand: was a bare `return;`
//                            that left the return slot uninitialized
//   subpiece_unknown_offset  SUBPIECE with an unknown offset: was lifted with
//                            offset 0
//   subpiece_known_offset    the same with a readable offset: not reported
//
// Each is reported, a warning by default and an error under -strict.  The
// RETURN that consumes the dropped SUBPIECE fails with it.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=WARN %s --input-file %t.log
// RUN: test -e %t.cir
// RUN: not %patchir-decomp -input %t.json -emit-cir -strict -output %t.strict > %t.strict.log 2>&1
// RUN: %file-check -vv -check-prefix=ERR %s --input-file %t.strict.log
// RUN: test ! -e %t.strict.cir
