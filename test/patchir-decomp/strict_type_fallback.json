// A type the builder cannot create is replaced with a stand-in, which changes
// a signature or a layout while every statement still builds.  Here a
// function-pointer parameter names an unknown parameter type and gets
// `void *`.  The default lift reports the substitution as a warning and still
// lowers; `-strict` turns the report into an error and stops before lowering.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=WARN %s --input-file %t.log
// RUN: %file-check -vv -check-prefix=TU %s --input-file %t.c
// RUN: not %patchir-decomp -input %t.json -emit-cir -strict -output %t.strict > %t.strict.log 2>&1
// RUN: %file-check -vv -check-prefix=ERR %s --input-file %t.strict.log
// RUN: test ! -e %t.strict.cir
//
// WARN: Diag Warning: {{.*}}lossy lift [type-fallback]: type 'type_fn': unknown parameter type 'type_nope' of a function type is replaced with void *
// WARN-NOT: Diag Error
// TU: void (*cb)(unsigned int, void *)
// ERR: Diag Error: {{.*}}lossy lift [type-fallback]: type 'type_fn': unknown parameter type 'type_nope' of a function type is replaced with void *
// ERR: Skipping code generation due to prior diagnostics errors
{
  "architecture": "ARM",
  "id": "ARM:LE:32:Cortex",
  "format": "Executable and Linking Format (ELF)",
  "functions": {
    "ram:10000000": {
