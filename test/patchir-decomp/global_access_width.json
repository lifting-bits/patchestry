// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=LOG %s --input-file %t.log
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=TU %s --input-file %t.c
// RUN: %cc-aarch64 -fsyntax-only -w -x c %t.c
// RUN: not %patchir-decomp -input %t.json -emit-llvm -strict -output %t.strict > %t.strict.log 2>&1
// RUN: %file-check -vv -check-prefix=ERR %s --input-file %t.strict.log
//
// An operation that reads or writes a named global accesses the bytes of the
// operation, not the bytes of the global's type.
//
//   struct ctl { unsigned kind : 8, level : 5, rate : 11, flags : 8; } g_ctl;
//   void set_kind(unsigned kind) { g_ctl.kind = kind; }    // strb: 1 byte
//   void set_rate(unsigned rate) { g_ctl.rate = rate; }    // ldr, bfi, str
//   unsigned get_rate(void)      { return g_ctl.rate; }
//
// set_kind, set_rate and get_rate are a Ghidra 12.2 export of that source for
// AArch64 with "Simplify bitfield access" on: a 1-byte COPY into g_ctl, a
// 4-byte INSERT into it and a 4-byte ZPULL from it.  The *_word functions are
// the same operations on g_word, a global typed as 2 bytes, made by retyping
// the global in a copy of each function.
//
// Assigning to the global itself wrote the width of the global: the 1-byte
// write cleared the bytes next to it, and on g_word the 4-byte write lost
// its upper half.
//
// LL-DAG: @g_ctl = external global %struct.ctl, align 4
// LL-DAG: @g_word = external global i16, align 2
//
// LL-LABEL: define dso_local i32 @get_rate(
// LL: load i32, ptr @g_ctl, align 4
// LL-NEXT: lshr i32 %{{[0-9]+}}, 13
//
// The read is four bytes at the alignment of the 2-byte global.
// LL-LABEL: define dso_local i32 @get_word_wide(
// LL: load i32, ptr @g_word, align 2
// LL-NEXT: lshr i32 %{{[0-9]+}}, 13
//
// LL-LABEL: define dso_local void @set_kind(
// LL: store i8 %{{[0-9]+}}, ptr @g_ctl
// LL-NOT: @g_ctl
// LL-NOT: @llvm.memcpy
//
// LL-LABEL: define dso_local void @set_rate(
// LL: load i32, ptr @g_ctl, align 4
// LL: store i32 %{{[0-9]+}}, ptr @g_ctl, align 4
// LL-NOT: @llvm.memcpy
//
// LL-LABEL: define dso_local void @set_word_narrow(
// LL: store i8 %{{[0-9]+}}, ptr @g_word
// LL-NOT: @g_word
//
// LL-LABEL: define dso_local void @set_word_wide(
// LL: load i32, ptr @g_word, align 2
// LL: store i32 %{{[0-9]+}}, ptr @g_word, align 2
//
// TU-DAG: *(unsigned char *)&g_ctl = (((unsigned char)kind) & 255);
// TU-DAG: *(undefined4 *)&g_ctl = ((*(unsigned int *)&g_ctl & 4278198271U) | ((rate & 2047U) << 13U));
// TU-DAG: typedef undefined4 unaligned2_undefined4 __attribute__((aligned(2)));
// TU-DAG: *(unsigned char *)&g_word =
// TU-DAG: *(unaligned2_undefined4 *)&g_word =
//
// A 4-byte access to the 2-byte global runs past it.  The lifted module does
// not keep whatever follows it in the binary adjacent, so the access is
// reported: a warning by default, an error under -strict.
// LOG-DAG: Diag Warning: {{.*}}lossy lift [global-access-width]: 4-byte access to global 'g_word', which is 2 bytes, in function 'set_word_wide'
// LOG-DAG: Diag Warning: {{.*}}lossy lift [global-access-width]: 4-byte access to global 'g_word', which is 2 bytes, in function 'get_word_wide'
// LOG-NOT: global 'g_ctl'
// LOG-NOT: op-dropped
// ERR: Diag Error: {{.*}}lossy lift [global-access-width]
