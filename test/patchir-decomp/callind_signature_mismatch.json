// An indirect call is lifted from what the call site passes and uses: the
// target is cast to a function pointer built from the CALLIND inputs and
// output.  When the type recovered for the target is a function type that
// says something else, the two disagree and the lift follows the call site.
// That is reported.  cb is `unsigned int (*)(unsigned int)` unless noted.
//
//   ind_match             r = cb(a)                      no report
//   ind_extra_arg         r = cb(a, b)                   one argument too many
//   ind_missing_arg       r = cb()                       one argument short
//   ind_wide_arg          r = cb(w), w is 64-bit         argument wider than the parameter
//   ind_wide_return       r = cb(a), r is 64-bit         result wider than the return type
//   ind_void_return_used  r = cb(a), cb returns void     result of a void function used
//   ind_return_ignored    cb(a)                          no report: nothing is lost
//   ind_untyped           r = cb(a), cb is an integer    no report: no recovered signature
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=WARN %s --input-file %t.log
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
// RUN: not %patchir-decomp -input %t.json -emit-llvm -strict -output %t.strict > %t.strict.log 2>&1
// RUN: %file-check -vv -check-prefix=ERR %s --input-file %t.strict.log
// RUN: test ! -e %t.strict.ll
