// A function recovered as returning `bool` whose RETURN operand is the integer
// 2 returns true.  The printed C must compile to the same value as the emitted
// LLVM: it keeps the `_Bool` return type, which converts 2 to 1.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -output %t >> /dev/null 2>&1
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
// RUN: sed -n '/@returns_two/,/^}/p' %t.ll > %t.fn.ll
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.fn.ll
//
// C: _Bool returns_two(_Bool flag) {
// C-NEXT: return 2;
// LL: define dso_local i32 @returns_two(i1 zeroext %0)
// LL: store i8 1,
// LL-NOT: i32 2
// LL: ret i32
{
