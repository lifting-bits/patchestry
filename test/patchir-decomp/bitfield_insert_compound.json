//
// The operand of a ZPULL, SPULL or INSERT can be an expression, and the
// printed C has to bind it as the IR does.
//
//   struct pair { unsigned a : 12, b : 12, c : 8; };
//   void set_or(struct pair *p, unsigned x, unsigned y) { p->b = x | y; }
//   unsigned get_sum(const struct pair *p, const struct pair *q) { return p->b + q->b; }
//
// Ghidra 12.2 export for AArch64 at -O1 with "Simplify bitfield access" on.
// The value inserted by set_or is the INT_OR of the two parameters.  It
// printed as `y | x & 4095U`, which masks only x: with x = 0 and y = 4096 the
// 13th bit of the value reached the next field.  The IR was always right.
//
// LL-LABEL: define dso_local i32 @get_sum(
// LL: lshr i32 %{{[0-9]+}}, 12
// LL-NEXT: and i32 %{{[0-9]+}}, 4095
// LL: lshr i32 %{{[0-9]+}}, 12
// LL-NEXT: and i32 %{{[0-9]+}}, 4095
// LL-NEXT: add i32
//
// LL-LABEL: define dso_local void @set_or(
// LL: [[V:%[0-9]+]] = or i32
// LL-NEXT: [[M:%[0-9]+]] = and i32 [[V]], 4095
// LL-NEXT: shl i32 [[M]], 12
//
// TU-DAG: *(unsigned int *)p = ((*(unsigned int *)&*p & 4278194175U) | (((y | x) & 4095U) << 12U));
// TU-DAG: return ((*(unsigned int *)&*q >> 12U) & 4095U) + ((*(unsigned int *)&*p >> 12U) & 4095U);
