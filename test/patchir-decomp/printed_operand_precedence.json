// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=TU %s --input-file %t.c
// RUN: %cc-aarch64 -fsyntax-only -w -x c %t.c
//
// The printed C binds operands as the expression tree does.  The lifter builds
// trees and the printer writes them without parentheses of its own, so an
// operand that binds more loosely than the operator above it has to be wrapped.
//
//   struct pair { unsigned a : 12, b : 12, c : 8; };
//   void set_mul(struct pair *p, unsigned x, unsigned y) { p->c = (x | y) * 3; }
//   unsigned plain_mul(unsigned x, unsigned y) { return (x | y) * 3; }
//   unsigned plain_mix(unsigned x, unsigned y, unsigned z) {
//       return ((x + y) << 3) - (z ^ (x & y)) / ((y - z) | 1);
//   }
//
// Ghidra 12.2 export for AArch64 at -O1 with "Simplify bitfield access" on.
// These printed as `y | x * 3`, `z ^ y & x / uVar1` and `y + x * 8 - uVar2`:
// with x = 1 and y = 2, set_mul stored 1 where the IR stores 9.  The IR was
// always right.  Operands that need no parentheses get none (`y - z | 1U`,
// `y & x` under `^`).
//
// LL-LABEL: define dso_local i32 @plain_mix(
// LL: [[S:%[0-9]+]] = add i32
// LL: mul i32 [[S]], 8
//
// LL-LABEL: define dso_local i32 @plain_mul(
// LL: [[O:%[0-9]+]] = or i32
// LL-NEXT: mul i32 [[O]], 3
//
// LL-LABEL: define dso_local void @set_mul(
// LL: [[B:%[0-9]+]] = or i32
// LL-NEXT: mul i32 [[B]], 3
//
// TU-DAG: *(unsigned char *)((char *)p + 3L) = ((((unsigned char)y) & 255) | (((unsigned char)x) & 255)) * 3;
// TU-DAG: return (y | x) * 3;
// TU-DAG: uVar1 = y - z | 1U;
// TU-DAG: uVar2 = (z ^ y & x) / uVar1;
// TU-DAG: return (y + x) * 8 - uVar2;
