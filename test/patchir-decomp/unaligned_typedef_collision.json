//
// An access at an address known to be under-aligned goes through a typedef
// the lifter generates, named after the alignment and the type
// (unaligned1_unsigned_int).  The program can already use that name.
//
// packed_set is the function of bitfield_pull_insert.json: a 4-byte bit-field
// unit at byte 1 of a packed struct, loaded as undefined4 and stored as
// unsigned int.  Two program typedefs are added that take the generated names:
//
//   typedef unsigned char unaligned1_unsigned_int;   another type
//   typedef undefined4    unaligned1_undefined4;     the same type, 4-aligned
//
// Reusing the first by name turned the 4-byte store into a 1-byte store.
// Reusing the second would bring back the align 4 the typedef exists to
// avoid.  A name is reused only for a typedef with the same type and the same
// alignment attribute; otherwise the next numbered name is taken.
//
// LL-LABEL: define dso_local void @packed_set(
// LL: [[A:%[0-9]+]] = getelementptr i8, ptr %{{[0-9]+}}, i64 1
// LL-NEXT: load i32, ptr [[A]], align 1
// LL-NOT: trunc
// LL: [[B:%[0-9]+]] = getelementptr i8, ptr %{{[0-9]+}}, i64 1
// LL-NEXT: store i32 %{{[0-9]+}}, ptr [[B]], align 1
//
// TU-DAG: typedef unsigned char unaligned1_unsigned_int;
// TU-DAG: typedef undefined4 unaligned1_undefined4;
// TU-DAG: typedef unsigned int unaligned1_unsigned_int_1 __attribute__((aligned(1)));
// TU-DAG: typedef undefined4 unaligned1_undefined4_1 __attribute__((aligned(1)));
// TU-DAG: *(unaligned1_unsigned_int_1 *)(undefined1 *)((char *)p + 1L) = ((*(unaligned1_undefined4_1 *)(undefined1 *)((char *)p + 1L) & 4227858495U) | ((mid & 1048575U) << 6U));
