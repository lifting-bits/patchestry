// Ghidra names a variable `unaff_<reg>` when a function reads a register it
// never wrote and that is not a parameter, and `in_<location>` for any other
// input the prototype does not cover.  The lifter declares both as ordinary
// uninitialized locals, so the lifted function does not read the value the
// binary read.  Each such local is reported; an ordinary local is not.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=WARN %s --input-file %t.log
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
// RUN: not %patchir-decomp -input %t.json -emit-cir -strict -output %t.strict > %t.strict.log 2>&1
// RUN: %file-check -vv -check-prefix=ERR %s --input-file %t.strict.log
// RUN: test ! -e %t.strict.cir
//
// WARN-DAG: Diag Warning: {{.*}}lossy lift [unaffected-register-use]: local 'unaff_r4' in function 'unaffected_register_use' is an input the prototype does not cover; it is lifted as an uninitialized local
