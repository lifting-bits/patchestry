//
// A bit-range operation can have an operand whose width has no integer type.
//
//   struct __attribute__((packed)) tri {
//       unsigned a : 5; unsigned b : 12; int c : 7; unsigned char tail;
//   };
//   unsigned tri_get_a(const struct tri *p) { return p->a; }
//   unsigned tri_get_b(const struct tri *p) { return p->b; }
//   int      tri_get_c(const struct tri *p) { return p->c; }
//   void     tri_set_b(struct tri *p, unsigned v) { p->b = v; }
