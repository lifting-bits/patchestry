// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=LOG --allow-empty %s --input-file %t.log
// RUN: %file-check -vv -check-prefix=GETU %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=GETS %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=GETTOP %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=SET %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=WGET %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=WSET %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=SGET %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=SSET %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=BIG %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=PACKED %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=NOCOPY %s --input-file %t.ll
// RUN: %file-check -vv -check-prefix=TU %s --input-file %t.c
// RUN: %cc-aarch64 -fsyntax-only -w -x c %t.c
//
// Ghidra 12.2 export of test/ghidra/bitfield.c, built for AArch64 at -O1, with
// the decompiler option "Simplify bitfield access" left on.  The export
// scripts turn that option off (see bitfield_shift_mask.json for what they
// produce), so this input does not come from them.  It keeps the lifter
// correct for JSON that does contain ZPULL, SPULL and INSERT.
//
// ZPULL and SPULL read a bit range of the container; INSERT yields the
// container with a bit range replaced.  The operands are the container, then
// for INSERT the new field value, then the bit position and the bit count.
// The containers here are 4, 8 and 1 bytes wide.
//
// reg_update is left out: with the option on, Ghidra itself reports its single
// register write as two, and no lifting can undo that.
//
// No operation may be dropped.
// LOG-NOT: unsupported mnemonic
// LOG-NOT: op-dropped
// LOG-NOT: return-synthesized
//
// A STORE writes the bytes of its value.  None of these functions copies a
// struct.
// NOCOPY-NOT: @llvm.memcpy
//
// unsigned count : 12 at bit 8.
// GETU-LABEL: define dso_local i32 @bitfield_get_unsigned
// GETU: lshr i32 %{{[0-9]+}}, 8
// GETU-NEXT: and i32 %{{[0-9]+}}, 4095
//
// int delta : 5 at bit 3, sign extended from bit 4.
// GETS-LABEL: define dso_local i32 @bitfield_get_signed(
// GETS: lshr i32 %{{[0-9]+}}, 3
// GETS-NEXT: and i32 %{{[0-9]+}}, 31
// GETS-NEXT: xor i32 %{{[0-9]+}}, 16
// GETS-NEXT: sub i32 %{{[0-9]+}}, 16
//
// int bias : 12 at bit 20, the top of the container.
// GETTOP-LABEL: define dso_local i32 @bitfield_get_signed_top(
// GETTOP: lshr i32 %{{[0-9]+}}, 20
// GETTOP-NEXT: and i32 %{{[0-9]+}}, 4095
// GETTOP-NEXT: xor i32 %{{[0-9]+}}, 2048
// GETTOP-NEXT: sub i32 %{{[0-9]+}}, 2048
//
// delta is written first, then count.  Each write keeps the other bits and
// stores four bytes to the destination.
// SET-LABEL: define dso_local void @bitfield_set(
// SET: and i32 %{{[0-9]+}}, -249
// SET: and i32 %{{[0-9]+}}, 31
// SET-NEXT: shl i32 %{{[0-9]+}}, 3
// SET-NEXT: or i32
// SET: store i32 %{{[0-9]+}}, ptr %{{[0-9]+}}, align 4
// SET: and i32 %{{[0-9]+}}, -1048321
// SET: and i32 %{{[0-9]+}}, 4095
// SET-NEXT: shl i32 %{{[0-9]+}}, 8
// SET-NEXT: or i32
// SET: store i32 %{{[0-9]+}}, ptr %{{[0-9]+}}, align 4
//
// long offset : 40 at bit 7 of a 64-bit container.
// WGET-LABEL: define dso_local i64 @bitfield_wide_get(
// WGET: lshr i64 %{{[0-9]+}}, 7
// WGET-NEXT: and i64 %{{[0-9]+}}, 1099511627775
// WGET-NEXT: xor i64 %{{[0-9]+}}, 549755813888
// WGET-NEXT: sub i64 %{{[0-9]+}}, 549755813888
//
// WSET-LABEL: define dso_local void @bitfield_wide_set(
// WSET: and i64 %{{[0-9]+}}, -140737488355201
// WSET: and i64 %{{[0-9]+}}, 1099511627775
// WSET-NEXT: shl i64 %{{[0-9]+}}, 7
// WSET-NEXT: or i64
// WSET: store i64 %{{[0-9]+}}, ptr %{{[0-9]+}}, align 8
//
// signed char mid : 3 at bit 2 of a 1-byte container.
// SGET-LABEL: define dso_local i32 @bitfield_small_get(
// SGET: load i8
// SGET-NEXT: zext i8 %{{[0-9]+}} to i32
// SGET-NEXT: lshr i32 %{{[0-9]+}}, 2
// SGET-NEXT: and i32 %{{[0-9]+}}, 7
// SGET-NEXT: xor i32 %{{[0-9]+}}, 4
// SGET-NEXT: sub i32 %{{[0-9]+}}, 4
//
// The 1-byte container is narrowed back to a byte and stored as one byte.
// SSET-LABEL: define dso_local void @bitfield_small_set(
// SSET: and i32 %{{[0-9]+}}, -29
// SSET: shl i32 %{{[0-9]+}}, 2
// SSET-NEXT: or i32
// SSET-NEXT: trunc i32 %{{[0-9]+}} to i8
// SSET: store i8 %{{[0-9]+}}, ptr %{{[0-9]+}}, align 1
// SSET: and i32 %{{[0-9]+}}, -225
// SSET: shl i32 %{{[0-9]+}}, 5
// SSET-NEXT: or i32
// SSET-NEXT: trunc i32 %{{[0-9]+}} to i8
// SSET: store i8 %{{[0-9]+}}, ptr %{{[0-9]+}}, align 1
//
// The destination points at a 48-byte struct.  Four bytes are stored, not the
// struct.
// BIG-LABEL: define dso_local void @big_set(
// BIG: and i32 %{{[0-9]+}}, -1048321
// BIG: shl i32 %{{[0-9]+}}, 8
// BIG-NEXT: or i32
// BIG: store i32 %{{[0-9]+}}, ptr %{{[0-9]+}}, align 4
//
// The destination points at one byte of a packed struct.  The four-byte unit
// is loaded and stored whole, not truncated to a byte.  Its address is byte 1
// of the struct, so both accesses are aligned to one byte, not four.
// PACKED-LABEL: define dso_local void @packed_set(
// PACKED: [[A:%[0-9]+]] = getelementptr i8, ptr %{{[0-9]+}}, i64 1
// PACKED-NEXT: load i32, ptr [[A]], align 1
// PACKED-NEXT: and i32 %{{[0-9]+}}, -67108801
// PACKED: shl i32 %{{[0-9]+}}, 6
// PACKED-NEXT: or i32
// PACKED-NOT: trunc
// PACKED: [[B:%[0-9]+]] = getelementptr i8, ptr %{{[0-9]+}}, i64 1
// PACKED-NEXT: store i32 %{{[0-9]+}}, ptr [[B]], align 1
//
// The printed C states the width of each access and compiles (the
// -fsyntax-only RUN line above).
// TU-DAG: return ((*(unsigned int *)&*f >> 8U) & 4095U);
// TU-DAG: return (int)((((*(unsigned int *)&*f >> 3U) & 31U) ^ 16U) - 16U);
// TU-DAG: *(unsigned int *)f = ((*(unsigned int *)&*f & 4293918975U) | ((count & 4095U) << 8U));
// TU-DAG: *(unsigned int *)b = ((*(unsigned int *)b & 4293918975U) | ((count & 4095U) << 8U));
// TU-DAG: typedef unsigned int unaligned1_unsigned_int __attribute__((aligned(1)));
// TU-DAG: *(unaligned1_unsigned_int *)(undefined1 *)((char *)p + 1L) = ((*(unaligned1_undefined4 *)(undefined1 *)((char *)p + 1L) & 4227858495U) | ((mid & 1048575U) << 6U));
