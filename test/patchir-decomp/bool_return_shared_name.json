// Two records share the name `is_set` with return types of the same size,
// `bool` and `unsigned char`, so the declaration gets one canonical return
// type, which may be either.  A RETURN must convert its value to the type the
// function is declared with; converting to the prototype's own type left a
// value that did not fit the return slot and failed ClangIR verification.
// Which type is canonical varies from run to run, so the lift is repeated.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -emit-llvm -output %t.1 > %t.1.log 2>&1
// RUN: %patchir-decomp -input %t.json -emit-cir -emit-llvm -output %t.2 > %t.2.log 2>&1
// RUN: %patchir-decomp -input %t.json -emit-cir -emit-llvm -output %t.3 > %t.3.log 2>&1
// RUN: %patchir-decomp -input %t.json -emit-cir -emit-llvm -output %t.4 > %t.4.log 2>&1
// RUN: %patchir-decomp -input %t.json -emit-cir -emit-llvm -output %t.5 > %t.5.log 2>&1
// RUN: %patchir-decomp -input %t.json -emit-cir -emit-llvm -output %t.6 > %t.6.log 2>&1
// RUN: %file-check -vv %s --input-file %t.1.ll
// CHECK: define dso_local {{i32|i8}} @is_set(i1 zeroext %0)
