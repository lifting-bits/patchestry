// JSON without the `live_in` flag falls back to Ghidra's `in_`/`unaff_` naming
// to find a local read before the function defines it.  A local whose address
// is taken can be written through the pointer, by a STORE that names no
// output, so the name proves nothing and the local is not reported.
//
//   stored_in       &in_count is stored through: lifted `in_count = a;`
//   never_written   in_count is only read: reported
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=WARN %s --input-file %t.log
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
//
// WARN: lossy lift [unaffected-register-use]: local 'in_count' in function 'never_written'
// WARN-NOT: in function 'stored_in'
// C: in_count = a;
{
  "architecture": "ARM",
  "id": "ARM:LE:32:Cortex",
  "format": "Executable and Linking Format (ELF)",
  "functions": {
    "ram:10000000": {
      "name": "stored_in",
      "is_intrinsic": false,
      "type": {
        "return_type": "type_int",
        "is_variadic": false,
        "is_noreturn": false,
        "calling_convention": "__stdcall",
        "parameter_types": [
          "type_int"
        ]
      },
      "basic_blocks": {
