// Every local is lifted as an independent C object, which loses the layout of
// the original stack frame.  The serializer records each local's storage and
// the lifter reports a local that overlaps, or directly follows, a local whose
// address is taken: an access through that address reached it in the binary
// and does not in the lifted code.  A warning by default, an error under
// -strict.
//
// split_record, read_second and overlap are Ghidra's output for
//
//   struct pair { int a; int b; };
//   void split_record(int a, int b) { struct pair p = { a, b }; consume(&p); }
//   int  read_second(void)          { struct pair p; fill(&p); return p.b; }
//   int  overlap(int v)             { union { int i; char c[4]; } u; u.i = v;
//                                     fill(&u.c[1]); return u.i; }
//
// built for arm-none-eabi -mcpu=cortex-m3 -O1.  The decompiler splits `p` into
// two 4-byte locals:
//
//   split_record: local_10 = param_1; uStack_c = param_2; consume(&local_10);
//                 uStack_c (sp-12) follows local_10 (sp-16) and is only written
//   read_second:  fill(auStack_10); return local_c;
//                 local_c (sp-12) follows auStack_10 (sp-16) and is only read
//   overlap:      one local, nothing to report
//
// piece_view is hand-written: `rec_lo` is a 4-byte view of the first half of
// the 8-byte `rec` (the shape Ghidra gives a field of a stack structure it
// tracks on its own) and is reported as overlapping.  `used` follows `rec` but
// is both written and read by the function, and `reg` lives in a register;
// neither is reported.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -print-tu -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=WARN %s --input-file %t.log
// RUN: test -e %t.cir
// RUN: not %patchir-decomp -input %t.json -emit-cir -strict -output %t.strict > %t.strict.log 2>&1
// RUN: %file-check -vv -check-prefix=ERR %s --input-file %t.strict.log
// RUN: test ! -e %t.strict.cir
