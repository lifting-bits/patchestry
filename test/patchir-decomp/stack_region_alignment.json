// A stack region is an array whose element is as wide as the strictest
// alignment among its members, so that every member's typed view is aligned.
// The alignment used to be capped at eight bytes: two 16-byte locals on
// AArch64 were placed in `unsigned long __stack_m48[4]` (align 8) and accessed
// as `unsigned __int128` (align 16).
//
// wide_record has two adjacent `unsigned __int128` locals at sp-48 and sp-32;
// the address of the first is passed to consume, so both share a region.
//
// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-llvm -print-tu -strict -output %t > %t.log 2>&1
// RUN: %file-check -vv -check-prefix=LOG %s --input-file %t.log --allow-empty
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
// RUN: %file-check -vv -check-prefix=LL %s --input-file %t.ll
//
// LOG-NOT: lossy lift
//
// C: unsigned __int128 __stack_m48[2];
// C: (*(unsigned __int128 *)__stack_m48) = param_1;
// C: (*(unsigned __int128 *)((unsigned char *)__stack_m48 + 16U)) = param_2;
//
// LL: alloca [2 x i128], i64 1, align 16
// LL-NOT: alloca [4 x i64]
