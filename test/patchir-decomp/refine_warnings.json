// RUN: bash %strip-json-comments %s > %t.json
// RUN: %patchir-decomp -input %t.json -emit-cir -print-tu -output %t 2>&1 | %file-check -vv -check-prefix=WARN %s
// RUN: %file-check -vv -check-prefix=C %s --input-file %t.c
